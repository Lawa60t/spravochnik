    "sole": 1,
    "shoulderEdgeU": 0.175,
    "waistEdgeU": 0.33,
    "hipEdgeU": 0.3
  },
  "calibration": {
    "_комментарий": [
      "Как прикрепить базу к новой модели. Заполняется один раз на каждую картинку.",
      "crownY и soleY — координаты макушки и подошв в системе координат картинки.",
      "axisX — горизонтальная координата осевой линии тела.",
      "halfWidth — расстояние от осевой линии до края фигуры на уровне плеч.",
      "Формула: X = axisX + (u - 0.5) * 2 * halfWidth ; Y = crownY + v * (soleY - crownY)"
    ],
    "example": {
      "asset": "figure-male-front.svg",
      "crownY": 20,
      "soleY": 700,
      "axisX": 140,
      "halfWidth": 75
    }
  },
